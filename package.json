{
  "name": "nestgh",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "predev": "node scripts/sync-public-frontend.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-public-frontend.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:security": "tsx --conditions=react-server --tsconfig tsconfig.json --test tests/security/*.test.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "test:db": "node scripts/test-db.mjs",
    "admin:create": "tsx scripts/create-admin.ts",
    "test:e2e": "node scripts/e2e.mjs",
    "demo:add": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/demo-data.ts add",
    "demo:remove": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/demo-data.ts remove"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "18.0.5",
    "mariadb": "3.4.5",
    "next": "16.3.8",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "5.16.1",
    "@types/node": "26.6.3",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autocannon": "^7.15.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.8",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
