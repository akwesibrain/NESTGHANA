# MySQL (XAMPP MariaDB, port 3308). DATABASE_URL is for the Prisma CLI (migrations/seed);
# DATABASE_APP_URL is the least-privilege user the website connects with.
DATABASE_URL="mysql://root@127.0.0.1:3308/nestghana"
DATABASE_APP_URL="mysql://nestgh_app:CHANGE_ME@127.0.0.1:3308/nestghana"
# Random secret used to hash visitor IPs (rate limiting).
IP_HASH_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
PUBLIC_SITE_URL=
PUBLIC_SITE_ORIGINS=
WHATSAPP_PROVIDER=
WHATSAPP_API_TOKEN=
WHATSAPP_SENDER_ID=
