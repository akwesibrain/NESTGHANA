# MySQL (XAMPP MariaDB, port 3308). DATABASE_URL is for the Prisma CLI (migrations/seed);
# DATABASE_APP_URL is the least-privilege user the website connects with.
DATABASE_URL="mysql://root@127.0.0.1:3308/nestghana"
DATABASE_APP_URL="mysql://nestgh_app:CHANGE_ME@127.0.0.1:3308/nestghana"
# Random secret used to hash visitor IPs (rate limiting).
IP_HASH_SECRET=
# 32-byte base64 key that encrypts admin authenticator secrets: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ADMIN_MFA_KEY=

# Paystack secret key (sk_test_... while testing). Online payment stays switched off until it is set.
# The webhook URL to enter in the Paystack dashboard is <PUBLIC_SITE_URL>/api/webhooks/paystack;
# Paystack signs webhooks with this same key.
PAYSTACK_SECRET_KEY=
# The live site's address, e.g. https://nestgh.com. Used for Paystack returns and for the owner
# manage links in WhatsApp messages (set it in production; locally it defaults to the request's host).
PUBLIC_SITE_URL=

# Optional: folder for private listing photos (default: ./storage/listing-images).
IMAGE_STORAGE_DIR=

# Cloudflare Turnstile bot protection for listing submissions and admin sign-in. Off until both are set.
# Cloudflare's always-pass test keys: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional: path to mysqldump for npm run db:backup (defaults to XAMPP's).
MYSQLDUMP_PATH=

# Buy Data (/buy-data) runs on its own separate backend (Supabase functions); these keys belong to it,
# not to the NestGH listings backend above.
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_PUBLIC_KEY=
TXTCONNECT_API_KEY=
TXTCONNECT_SENDER_ID=
